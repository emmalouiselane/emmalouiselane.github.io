---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListeningItemMedia from '../../../components/ListeningItemMedia.astro';
import { getAllListeningItems } from '../../../lib/contentful';
import { getSpotifyLinks } from '../../../lib/spotify';
import { displayMarkdown } from '../../../lib/richTextOptions';
import { isPlaylist, selectListeningHighlights } from '../../../lib/listening';

const listeningItems = selectListeningHighlights(await getAllListeningItems()).map(item => {
  const spotify = getSpotifyLinks(item.spotifyUrl);
  return {
    ...item,
    spotify,
    personalDescriptionHtml: displayMarkdown(item.personalDescription),
    isPlaylist: isPlaylist(item),
  };
});
---

<BaseLayout title="Listening" description="Music, playlists and listening favourites from Emma Lane’s digital garden.">
  <div class="listening-page">
    <section class="listening-hero">
      <p class="home-kicker">Digital garden</p>
      <h1>What I am listening to.</h1>
      <p>
        Music holds a very special place in my heart. It helps me focus, unwind, feel things properly, or get a little more energy when I need it.
      </p>
      <p>
        You can explore more of my favourite playlists on <a href="https://open.spotify.com/user/31kzx7kmb4wuf2b6vhrup3xbchry">my Spotify profile</a>. I am always looking for new music or podcasts, so recommendations are always very welcome.
      </p>
      <div class="garden-hero-flower garden-hero-flower--herb" aria-hidden="true">
        <img src="/images/flowers/pressed-herb.svg" alt="" width="220" height="238" />
      </div>
    </section>

    <section class="listening-card-list" aria-label="Listening recommendations">
      {listeningItems.length === 0 ? (
        <p>I'll share more listening favourites here soon.</p>
      ) : listeningItems.map(item => (
        <article class:list={['listening-card', { 'listening-card--playlist': item.isPlaylist }]}>
          <div class="listening-card__content">
            {item.type && <p class="home-card__eyebrow">{item.type}</p>}
            <h2>{item.title}</h2>
            {item.personalDescriptionHtml && <div class="listening-card__description" set:html={item.personalDescriptionHtml} />}
          </div>

          <ListeningItemMedia item={item} />
        </article>
      ))}
    </section>
  </div>
</BaseLayout>


