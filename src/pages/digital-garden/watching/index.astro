---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WatchListComponent from '../../../components/WatchListComponent';
import { getAllWatchList } from '../../../lib/contentful';

const items = (await getAllWatchList()).map(({ thoughts, ...item }) => ({ ...item, hasThoughts: Boolean(thoughts) }));
---
<BaseLayout title="Watching" description="Films and television in Emma Lane’s watch list, with personal thoughts, viewing notes and progress updates.">
  <WatchListComponent initialWatchList={items} client:load />
</BaseLayout>
