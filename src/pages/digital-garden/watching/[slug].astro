---
import type { GetStaticPaths } from 'astro';

import type { WatchList } from '../../../lib/types/watchList';
import { getWatchListById, getAllWatchList } from '../../../lib/contentful';
import { displayRichText } from '../../../lib/richTextOptions';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import AuthorNoteComponent from '../../../components/AuthorNoteComponent.astro';
import { person, richTextSummary, siteMetadata } from '../../../lib/seo';

export const getStaticPaths = (async () => {
  const watchList = await getAllWatchList();

  return watchList.map((item: WatchList) => ({
    params: { slug: item.sys.id },
    props: { item },
  }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const pathname = Astro.url.pathname;

if (!item?.sys?.id) {
  throw new Error('Watch list item ID is required but not found');
}
const watchItem = await getWatchListById(item.sys.id);

const description = richTextSummary(watchItem.thoughts, `Emma Lane’s watching notes for ${watchItem.title}, with viewing status and ${watchItem.type.toLowerCase()} details.`);

const structuredData = watchItem.thoughts ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: `Watching notes: ${watchItem.title}`, description,
  author: { '@type': 'Person', '@id': person['@id'], name: person.name, url: person.url },
  mainEntityOfPage: `${siteMetadata.url}/digital-garden/watching/${watchItem.sys.id}/`,
} : undefined;

const getTypeFilterUrl = (type: string) => `/digital-garden/watching/?type=${encodeURIComponent(type)}`;
const getStatusFilterUrl = (status: string) => `/digital-garden/watching/?status=${encodeURIComponent(status)}`;
---

<BaseLayout title={`${watchItem.title} - Watch List`} description={description} type="article" structuredData={structuredData}>
  <div class="garden-detail-page watching-detail-page">
    <article>
      <header class="garden-detail-hero">
        <div>
          <p class="home-kicker">Watching notes</p>
          <h1>{watchItem.title}</h1>
          {watchItem.platform && (
            <p>{watchItem.status === 'Watching' ? `Currently watching on ${watchItem.platform}` : `Watched on ${watchItem.platform}`}</p>
          )}
        </div>

        <div class="garden-hero-flower garden-hero-flower--sprig" aria-hidden="true">
          <img src="/images/flowers/pressed-sprig.svg" alt="" width="220" height="252" />
        </div>

        <div class="garden-detail-meta">
          <button class="tinylytics_kudos" data-path={pathname}></button>
        </div>
      </header>

      <div class="garden-tag-list">      
          {watchItem.type && (
            <a href={getTypeFilterUrl(watchItem.type)} title={`See more ${watchItem.type} watches`}>
              {watchItem.type}
            </a>
          )}
          {watchItem.status && (
            <a href={getStatusFilterUrl(watchItem.status)} title={`See more ${watchItem.status.toLowerCase()} watches`}>
              {watchItem.status}
            </a>
          )}
        </div>

      <section class="garden-detail-panel garden-detail-body">
        <p class="home-card__eyebrow">My thoughts</p>
        {
          watchItem.thoughts ? (
            <Fragment set:html={displayRichText(watchItem.thoughts)} />
          ) : (
            <p>No thoughts have been recorded for this watch yet.</p>
          )
        }
      </section>

      <AuthorNoteComponent />
    </article>
  </div>
</BaseLayout>




