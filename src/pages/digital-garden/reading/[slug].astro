---
import type { GetStaticPaths } from 'astro';

import type { BookReview } from '../../../lib/types/bookReview';
import { getAllBookReviews, getBookReviewById } from '../../../lib/contentful';
import { displayRichText } from '../../../lib/richTextOptions';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import AuthorNoteComponent from '../../../components/AuthorNoteComponent.astro';

export const getStaticPaths = (async () => {
  const bookReviews = await getAllBookReviews();

  return bookReviews.map((review: BookReview) => ({
    params: { slug: review.sys.id },
    props: { review },
  }));
}) satisfies GetStaticPaths;

const { review } = Astro.props;
const pathname = Astro.url.pathname;

if (!review?.sys?.id) {
  throw new Error('Book review ID is required but not found');
}
const fullReview = await getBookReviewById(review.sys.id);

const getGenreFilterUrl = (genre: string) => `/digital-garden/reading/?genre=${encodeURIComponent(genre)}`;

const renderStars = (rating: number) => {
  let stars = '';
  for (let i = 1; i <= 5; i++) {
    stars += String.fromCharCode(i <= rating ? 9733 : 9734);
  }
  return stars;
};
---

<BaseLayout title={`${fullReview.title} - Book Review`} description={`Review of ${fullReview.title} by ${fullReview.author.name}`}>
  <div class="garden-detail-page reading-detail-page">
    <article itemscope itemtype="http://schema.org/Review">
      <header class="garden-detail-hero">
        <div>
          <p class="home-kicker">Reading notes</p>
          <h1>{fullReview.title}</h1>
          <p>by <strong>{fullReview.author.name}</strong></p>
        </div>

        <div class="garden-hero-flower garden-hero-flower--bloom" aria-hidden="true">
          <img src="/images/flowers/pressed-bloom.svg" alt="" />
        </div>

        <div class="garden-detail-meta">
          <div class="garden-detail-rating" aria-label={`${fullReview.starRating ?? 0} out of 5 stars`}>
            <span>{renderStars(fullReview.starRating ?? 0)}</span>
            <small>({fullReview.starRating ?? 0}/5)</small>
          </div>

          {fullReview.amazonLink && (
            <a href={fullReview.amazonLink} target="_blank" rel="noopener noreferrer">
              View on Amazon
            </a>
          )}

          <button class="tinylytics_kudos" data-path={pathname}></button>
        </div>       
      </header>

      {(fullReview.genres?.length > 0) && (
          fullReview.genres && fullReview.genres.length > 0 && (
            <div class="garden-tag-list">
              {fullReview.genres.map((genre: string) => (
                <a href={getGenreFilterUrl(genre)} title={`See more ${genre} books`}>
                  {genre}
                </a>
              ))}
            </div>
          )
      )}

      <section class="garden-detail-panel garden-detail-body">
        {fullReview.completionDate ? 
          (<p class="home-card__eyebrow">My thoughts ~ Finished reading {new Date(fullReview.completionDate).toLocaleDateString()}</p>) :
          (<p class="home-card__eyebrow">My thoughts</p>)
        }

        {
          fullReview.thoughts ? (
            <Fragment set:html={displayRichText(fullReview.thoughts)} />
          ) : (
            <p>No thoughts have been recorded for this book yet.</p>
          )
        }
      </section>

      <AuthorNoteComponent />
    </article>
  </div>
</BaseLayout>






