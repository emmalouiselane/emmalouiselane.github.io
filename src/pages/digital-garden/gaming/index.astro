---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Gaming" description="Gaming guides and resources">
  <div class="gaming-index-page">
    <section class="gaming-hero">
      <p class="home-kicker">Digital garden</p>
      <h1>Gaming notes and cosy references.</h1>
      <p>
        A small home for game guides, reminders and resources I want close by while I am playing. Currently mostly Stardew Valley, because of course it is.
      </p>
          <div class="garden-hero-flower garden-hero-flower--herb" aria-hidden="true">
        <img src="/images/flowers/pressed-herb.svg" alt="" />
      </div>
    </section>

    <section class="gaming-card-list" aria-label="Gaming guides">
      <article class="gaming-card">
        <div class="gaming-card__topline">
          <p class="home-card__eyebrow">Cosy game notes</p>
          <span>Guide</span>
        </div>

        <h2>
          <a href="/digital-garden/gaming/stardew-valley/">Stardew Valley</a>
        </h2>
        <p>My personal guide and reference stash for Stardew Valley, including museum layout notes and fishing resources.</p>

        <a class="gaming-card__link" href="/digital-garden/gaming/stardew-valley/">
          Visit guide
        </a>
      </article>
    </section>
  </div>
</BaseLayout>

