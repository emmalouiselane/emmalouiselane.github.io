---
import RecipeCard from '@sparklane.dev/sparklane-recipecard-react';
import '@sparklane.dev/sparklane-recipecard-react/dist/RecipeCard.css';
import { createRecipeImage } from '../../../components/RecipeImageComponent';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllRecipes } from '../../../lib/contentful';

const recipes = await getAllRecipes();
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<BaseLayout title="Recipes" description="Browse my collection of recipes.">
  <div class="recipe-index-page">
    <section class="recipe-index-hero">
      <div>
        <p class="home-kicker">Digital garden</p>
        <h1>Recipes I want to come back to.</h1>
        <p>
          A practical little archive of recipes, experiments and reliable favourites.
        </p>
         <p>
          Some are polished, some are notes-to-self, and all of them are here because I wanted an easy way back to them.
        </p>
      </div>

      <div class="pressed-hero-flower pressed-hero-flower--bloom" aria-hidden="true">
        <img src="/images/flowers/pressed-bloom.svg" alt="" />
      </div>

      <div class="recipe-index-toolbar">
        <p><strong>{recipes.length}</strong> saved recipes</p>
        <div class="recipe-index-actions">
          <button
            id="toggleSearch"
            class="recipe-icon-button"
            aria-label="Toggle search"
          >
            <svg class="recipe-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </button>
          <button
            id="clearSearch"
            class="recipe-icon-button recipe-icon-button--secondary"
            aria-label="Clear search"
            title="Clear filters"
            disabled
          >
            <svg class="recipe-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
            </svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Search Wrapper -->
    <div class="recipe-filter-wrapper">
      <!-- Search Section (Hidden by default) -->
      <div id="searchSection" class="recipe-filter-panel is-hidden">
        <div class="recipe-filter-field">
          <label for="search">Search recipes</label>
          <div class="recipe-search-row">
            <input
              type="text"
              id="search"
              placeholder="Search by recipe name..."
            />
            <button id="searchBtn">
              Search
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Letter Filter Section (Always Visible) -->
    <section class="recipe-letter-panel" aria-label="Recipe first-letter filter">
      <span>Filter by first letter</span>
      <div class="recipe-letter-buttons" id="letterButtons">
        <button data-letter="all">
          All
        </button>
        {letters.map((letter: string) => (
          <button data-letter={letter}>
            {letter}
          </button>
        ))}
      </div>
    </section>

    <!-- No Results Message -->
    <div id="noResults" class="recipe-empty-state is-hidden">
      <p>No recipes found</p>
      <small>Try adjusting your search or letter filter.</small>
    </div>

    <div class="recipe-list" id="recipeList">
      {
        recipes
          .sort((a: any, b: any) => a.name.localeCompare(b.name))
          .map((recipe: any) => (
            <div class="recipe-list__item" data-recipe-name={recipe.name.toLowerCase()} data-recipe-slug={recipe.slug}>
              <RecipeCard
                name={recipe.name}
                image={createRecipeImage({ imageUrl: recipe.imagesCollection?.items?.[0]?.url, recipeName: recipe.name })}
                rating={recipe.rating}
                recipeCardOverrideClassName="recipe-card-custom"
                emptyRatingClassName="recipe-empty-rating"
                showRatingNumber={false}
                showRecipeButton={true}
                recipeButtonClassName="recipe-card-button"
              />
            </div>
          ))
      }
    </div>
  </div>

  <script>
    let currentLetter = 'all';

    function updateClearButtonState() {
      const searchInput = document.getElementById('search') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clearSearch') as HTMLButtonElement | null;
      const hasSearch = searchInput ? searchInput.value !== '' : false;
      const hasLetterFilter = currentLetter !== 'all';

      if (clearBtn) {
        clearBtn.disabled = !hasSearch && !hasLetterFilter;
      }
    }

    function clearSearch() {
      // Clear search input
      const searchInput = document.getElementById('search') as HTMLInputElement | null;
      if (searchInput) searchInput.value = '';

      // Reset to "All" letter filter
      setLetter('all');

      // Hide search section
      const searchSection = document.getElementById('searchSection');
      const toggleBtn = document.getElementById('toggleSearch');
      if (searchSection && !searchSection.classList.contains('is-hidden')) {
        searchSection.classList.add('is-hidden');
        if (toggleBtn) {
          toggleBtn.innerHTML = `
            <svg class="recipe-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          `;
        }
      }
    }

    function toggleSearch() {
      const searchSection = document.getElementById('searchSection');
      const toggleBtn = document.getElementById('toggleSearch');

      if (searchSection && toggleBtn) {
        if (searchSection.classList.contains('is-hidden')) {
          searchSection.classList.remove('is-hidden');
          toggleBtn.innerHTML = `
            <svg class="recipe-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          `;
        } else {
          searchSection.classList.add('is-hidden');
          toggleBtn.innerHTML = `
            <svg class="recipe-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          `;
        }
      }
    }

    function filterRecipes() {
      const searchInput = document.getElementById('search') as HTMLInputElement;
      const searchTerm = searchInput.value.toLowerCase();
      const recipeCards = document.querySelectorAll('[data-recipe-name]');
      const noResults = document.getElementById('noResults');
      let visibleCount = 0;

      recipeCards.forEach((item) => {
        const htmlItem = item as HTMLElement;
        const recipeName = htmlItem.dataset.recipeName || '';
        const matchesSearch = recipeName.includes(searchTerm);
        const matchesLetter = currentLetter === 'all' || recipeName.startsWith(currentLetter.toLowerCase());

        if (matchesSearch && matchesLetter) {
          htmlItem.style.display = 'block';
          visibleCount++;
        } else {
          htmlItem.style.display = 'none';
        }
      });

      // Update clear button state
      updateClearButtonState();

      // Show/hide no results message
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('is-hidden');
        } else {
          noResults.classList.add('is-hidden');
        }
      }
    }

    function setLetter(letter: string) {
      currentLetter = letter;

      // Update button styles
      (document.querySelectorAll('#letterButtons button') as NodeListOf<HTMLButtonElement>).forEach((btn: HTMLButtonElement) => {
        if (btn.dataset.letter === letter) {
          btn.style.backgroundColor = 'var(--color-primary)';
          btn.style.color = 'var(--primary-foreground)';
          btn.classList.add('is-active');
        } else {
          btn.style.backgroundColor = '';
          btn.style.color = '';
          btn.classList.remove('is-active');
        }
      });

      filterRecipes();
    }

    // Initialize event listeners
    document.addEventListener('DOMContentLoaded', function() {
      const toggleSearchBtn = document.getElementById('toggleSearch');
      const clearSearchBtn = document.getElementById('clearSearch');
      const searchBtn = document.getElementById('searchBtn');
      const searchInput = document.getElementById('search') as HTMLInputElement | null;

      if (toggleSearchBtn) toggleSearchBtn.addEventListener('click', toggleSearch);
      if (clearSearchBtn) clearSearchBtn.addEventListener('click', clearSearch);
      if (searchBtn) searchBtn.addEventListener('click', filterRecipes);
      if (searchInput) {
        searchInput.addEventListener('input', updateClearButtonState);
        searchInput.addEventListener('keypress', function(event) {
          if (event.key === 'Enter') {
            filterRecipes();
          }
        });
      }

      // Letter button event listeners
      (document.querySelectorAll('#letterButtons button') as NodeListOf<HTMLButtonElement>).forEach((btn: HTMLButtonElement) => {
        btn.addEventListener('click', function(this: HTMLButtonElement) {
          setLetter(this.dataset.letter || '');
        });
      });

      // Recipe button event delegation
      document.addEventListener('click', function(event) {
        const target = event.target as HTMLElement;
        const recipeButton = target.closest('.recipe-button, .recipe-card-button');
        if (recipeButton) {
          const recipeCard = recipeButton.closest('[data-recipe-slug]');
          if (recipeCard) {
            const slug = recipeCard.getAttribute('data-recipe-slug');
            if (slug) {
              window.location.href = `/digital-garden/recipes/${slug}/`;
            }
          }
        }
      });

      // Set initial state
      setLetter('all');
    });
  </script>
</BaseLayout>

