---
import type { GetStaticPaths } from 'astro';
import 'react-toastify/dist/ReactToastify.css';
import { ToastContainer } from 'react-toastify';

import type { Recipe } from '../../../lib/types/recipe';
import { getAllRecipes, getRecipeBySlug } from '../../../lib/contentful';
import { displayRichText } from '../../../lib/richTextOptions';
import { normalizeAssetUrl } from '../../../lib/utils';

import RecipeStructuredData from '../../../components/RecipeStructuredData.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const recipes = await getAllRecipes();

  return recipes.map((recipe: Recipe
  ) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}) satisfies GetStaticPaths;

const { recipe } = Astro.props;
const pathname = Astro.url.pathname;

if (!recipe?.slug) {
  throw new Error('Recipe slug is required but not found');
}
const fullRecipe = await getRecipeBySlug(recipe.slug);
const hasImages = fullRecipe.imagesCollection && fullRecipe.imagesCollection.items && fullRecipe.imagesCollection.items.length > 0;
const firstImage = hasImages && fullRecipe.imagesCollection?.items[0] ? fullRecipe.imagesCollection?.items[0] : null;

const recipeImageUrl = normalizeAssetUrl(firstImage?.url);
const displayImageUrl = recipeImageUrl || '/images/no-image.jpg';
const imageAlt = firstImage ? (firstImage.title || fullRecipe.name) : 'No image available';

---

<script>
  import { toast } from 'react-toastify';
  
  let wakeLock: WakeLockSentinel | null = null;
  
  async function enableWakeLock() {
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      console.log('Screen will stay awake!');
      toast.success('Screen will stay awake!');

      wakeLock.addEventListener('release', () => {
        console.log('Screen can sleep');
      });
    } catch (err: any) {
      console.error(`${err.name}, ${err.message}`);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const keepAwakeButton = document.getElementById("keepAwakeButton");

    keepAwakeButton?.addEventListener("click", function () {
      enableWakeLock();
    });

  });  
</script>

<BaseLayout title={fullRecipe.name} description={"Recipe for " + fullRecipe.name} image={recipeImageUrl}>
  <RecipeStructuredData recipe={fullRecipe} imageUrl={recipeImageUrl} />
  
  <ToastContainer client:load theme="light" position="top-right" 
                  closeOnClick={false} autoClose={2500} pauseOnFocusLoss={false}
                  draggable={false} pauseOnHover={false}/>
  <article class="recipe">
    <section class="recipe-hero">
      <div class="recipe-hero__copy">
        <p class="recipe-kicker">Recipe archive</p>
        <h1 class="recipe-title">{fullRecipe.name}</h1>
        {fullRecipe.personalNote && (
          <p class="recipe-hero__subtitle">
            <strong><i>A note from me... </i></strong>
            {fullRecipe.personalNote}
          </p>
        )}
      </div>

      <div class="recipe-hero__meta">
        <div>
          {fullRecipe.rating ? (
            <p class="recipe-rating">Rating: {String.fromCharCode(9733).repeat(fullRecipe.rating)}</p>
          ) : (
            <p class="recipe-rating recipe-rating--empty">Not rated yet</p>
          )}
          <button class="tinylytics_kudos" data-path={pathname}></button>
        </div>
        <button id="keepAwakeButton" class="recipe-awake-button">
          Keep Screen Awake?
        </button>
      </div>
    </section>
    
    <section class="recipe-overview recipe-overview--with-image">
      <div class="recipe-overview__ingredients">
        <div class="recipe-panel">
          <h2 class="recipe-section-title recipe-section-title--ingredients">Ingredients</h2>
          {fullRecipe.ingredients && (
            <Fragment set:html={displayRichText(fullRecipe.ingredients)} />
          )}
        </div>
      </div>
      
      <div class="recipe-overview__side">
        <div class="recipe-image-card">
          <img
            src={displayImageUrl}
            alt={imageAlt}
            class="recipe-image"
          />
          {firstImage?.description && (
            <p class="recipe-image-description">{firstImage.description}</p>
          )}
        </div>

        <div class="recipe-notes">
          {fullRecipe.notes && (
            <blockquote class="pink recipe-note">
              <h2 class="recipe-note-title">Notes</h2>
              <Fragment set:html={displayRichText(fullRecipe.notes)} />
            </blockquote>
          )}
        </div>
      </div>
    </section>
        
    <section class="recipe-body">
      <div class="recipe-panel recipe-panel--method">
        <h2 class="recipe-section-title">Method</h2>
        {fullRecipe.directions && (
          <Fragment set:html={displayRichText(fullRecipe.directions)} />
        )}
      </div>
    </section>
       
    {fullRecipe.review && (
      <section class="recipe-review">
        <h2 class="recipe-section-title">Review</h2>
        <div class="recipe-panel recipe-panel--review">
          <Fragment set:html={displayRichText(fullRecipe.review)} />
        </div>
      </section>
    )}
  </article>
</BaseLayout>
