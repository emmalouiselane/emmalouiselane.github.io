---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllBlogs, getAllPortfolioItems } from "../../lib/contentful";
import type { BlogPost } from "../../lib/types/blogPost";
import type { PortfolioItem } from "../../lib/types/portfolioItem";
import moment from "moment";

const blogPosts = await getAllBlogs();
const portfolioItems = await getAllPortfolioItems();

const dissertationPosts = blogPosts
  .filter((post: BlogPost) =>
    (post.blogType || []).some((type) => type.toLowerCase().includes("dissertation"))
  )
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const dissertationItem = portfolioItems.find(
  (item: PortfolioItem) => item.slug.toLowerCase() === "msc-deepfake-defence"
);
---

<BaseLayout title="Dissertation" description="Everything related to my MSc dissertation in one place.">
  <div class="dissertation-hub-page">
    <section class="dissertation-hub-hero">
      <p class="home-kicker">Research</p>
      <h1>Dissertation hub</h1>
      <p>
        Everything related to my MSc dissertation in one place: the main Deepfake Defence project, supporting posts, and all of the notes I wanted to keep together.
      </p>
      <div class="pressed-hero-flower pressed-hero-flower--herb" aria-hidden="true">
        <img src="/images/flowers/pressed-herb.svg" alt="" />
      </div>
    </section>

    {dissertationItem && (
      <article class="dissertation-feature-card" itemscope itemtype="http://schema.org/CreativeWork">
        <div class="post-list-item__topline">
          <p class="home-card__eyebrow">Featured project</p>
          {dissertationItem.sys?.publishedAt && (
            <time datetime={dissertationItem.sys.publishedAt}>
              {moment(dissertationItem.sys.publishedAt).format("DD MMM YYYY")}
            </time>
          )}
        </div>

        <h2>{dissertationItem.title}</h2>
        <p>{dissertationItem.description}</p>

        <a class="post-list-item__link" href={`/portfolio/${dissertationItem.slug}/`}>
          View project
        </a>
      </article>
    )}

    <section class="dissertation-post-section">
      <div class="home-section__heading">
        <p class="home-kicker">Related writing</p>
      </div>

      {dissertationPosts.length === 0 ? (
        <div class="blog-empty-state">
          <p>No dissertation-tagged posts found yet.</p>
        </div>
      ) : (
        <div class="blog-list dissertation-blog-list">
          {dissertationPosts.map((post: BlogPost) => (
            <article class="post-list-item" itemscope itemtype="http://schema.org/Article">
              <div class="post-list-item__topline">
                <time datetime={post.date}>{moment(post.date).format("DD MMM YYYY")}</time>
              </div>

              <h2>{post.title}</h2>
              <p>{post.description}</p>

              <a class="post-list-item__link" href={`/blog-posts/${post.slug}/`}>
                Read more
              </a>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

