---
import { formatDate } from '../../lib/dates';
import type { GetStaticPaths } from 'astro';

import type { BlogPost } from '../../lib/types/blogPost';
import { getAllBlogs, getBlogPostBySlug } from '../../lib/contentful';
import { displayRichText } from '../../lib/richTextOptions';

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorNoteComponent from '../../components/AuthorNoteComponent.astro';
import { person, siteMetadata } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const blogPosts = await getAllBlogs();
  
  return blogPosts.map((post: BlogPost) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const pathname = Astro.url.pathname;

if (!post?.slug) {
  throw new Error('Blog post slug is required but not found');
}
const fullPost = await getBlogPostBySlug(post.slug);

const blogContentHtml = fullPost.blogContent ? displayRichText(fullPost.blogContent) : '';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  '@id': `${siteMetadata.url}/blog-posts/${fullPost.slug}/#article`,
  headline: fullPost.title, description: fullPost.description,
  datePublished: fullPost.date,
  ...(fullPost.sys.publishedAt ? { dateModified: fullPost.sys.publishedAt } : {}),
  author: { '@type': 'Person', '@id': person['@id'], name: person.name, url: person.url },
  mainEntityOfPage: `${siteMetadata.url}/blog-posts/${fullPost.slug}/`,
  inLanguage: 'en-GB',
};
const getBlogTypeFilterUrl = (type: string) => `/blog-posts/?type=${encodeURIComponent(type)}`;
---

<BaseLayout title={fullPost.title} description={fullPost.description} type="article" structuredData={structuredData}>
  <div class="blog-post">
    <article>
      <header class="blog-detail-hero">
        <div class="blog-detail-hero__copy">
          <p class="home-kicker">Blog Post</p>
          <h1>{fullPost.title}</h1>
          {fullPost.description && <p>{fullPost.description}</p>}
        </div>

        <div class="pressed-hero-flower pressed-hero-flower--bloom" aria-hidden="true">
          <img src="/images/flowers/pressed-bloom.svg" alt="" width="220" height="220" />
        </div>

        <div class="blog-detail-meta">
          <time datetime={fullPost.date}>{formatDate(fullPost.date)}</time>
          <button class="tinylytics_kudos" data-path={pathname}></button>
        </div>
      </header>

      {fullPost.blogType?.length > 0 && (
        <div class="blog-detail-tags" aria-label="Blog post categories">
          {fullPost.blogType.map((type: string) => (
            <a href={getBlogTypeFilterUrl(type)} title={`See more ${type} posts`}>
              {type}
            </a>
          ))}
        </div>
      )}
      
      <section class="blog-detail-panel blog-detail-body">
        <Fragment set:html={blogContentHtml} />
      </section>
      
      <AuthorNoteComponent />
    </article>
  </div>
</BaseLayout>
