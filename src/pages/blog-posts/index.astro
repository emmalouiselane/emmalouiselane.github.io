---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostsListComponent from '../../components/BlogPostsListComponent';
import { getAllBlogs } from '../../lib/contentful';

const items = await getAllBlogs();
---
<BaseLayout title="Blog Posts" description="Development notes, accessibility articles, research updates and personal writing by software engineer Emma Lane.">
