---
import type { GetStaticPaths } from 'astro';

import type { PortfolioItem } from '../../lib/types/portfolioItem';
import { getAllPortfolioItems, getPortfolioItemBySlug } from '../../lib/contentful';
import { displayLongText, displayRichText } from '../../lib/richTextOptions';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentImage from '../../components/ContentImage.astro';
import { person, siteMetadata } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const portfolioItems = await getAllPortfolioItems();
  
  return portfolioItems.map((item: PortfolioItem) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const pathname = Astro.url.pathname;

if (!item?.slug) {
  throw new Error('Portfolio item slug is required but not found');
}
const fullItem = await getPortfolioItemBySlug(item.slug);
const imageItems = fullItem.images?.items?.filter((image) => image?.url) ?? [];
const hasImages = imageItems.length > 0;

const structuredData = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  name: fullItem.title, description: fullItem.description,
  url: `${siteMetadata.url}/portfolio/${fullItem.slug}/`,
  creator: { '@id': person['@id'] },
  ...(hasImages ? { image: imageItems.map(image => image.url) } : {}),
};

---

<BaseLayout title={fullItem.title} description={fullItem.description} image={imageItems[0]?.url} imageAlt={imageItems[0]?.description || `${fullItem.title} project preview`} structuredData={structuredData}>
  <div class="portfolio-detail-page">
    <header class="portfolio-detail-hero">
      <div>
        <p class="home-kicker">Portfolio</p>
        <h1>{fullItem.title}</h1>
        <p>{fullItem.description}</p>
      </div>

      <div class="portfolio-detail-meta">
        <button class="tinylytics_kudos portfolio-detail-kudos" data-path={pathname}></button>

        {fullItem.isInDevelopment && (
          <span>
            In Development
          </span>
        )}
        {fullItem.isIframe && (
          <span>
            Live Demo
          </span>
        )}
      </div>
    </header>
    
    <div class="portfolio-detail-grid">
      <section class="portfolio-detail-main">
        <div class="portfolio-detail-panel">
          <h2>Project Details</h2>
          <div class="portfolio-detail-richtext-content">
            <Fragment set:html={displayLongText(fullItem.detailedDescription || fullItem.description)} />
          </div>

          <div class="portfolio-detail-links">
            {fullItem.externalUrl ? (
              <a href={fullItem.externalUrl} target="_blank" rel="noopener noreferrer" class="link">
                View Live Site
              </a>
            ) : (
              <span class="link link-disabled" aria-disabled="true">
                View Live Site
              </span>
            )}
            {fullItem.githubUrl ? (
              <a href={fullItem.githubUrl} target="_blank" rel="noopener noreferrer" class="link">
                View on GitHub
              </a>
            ) : (
              <span class="link link-disabled" aria-disabled="true">
                View on GitHub
              </span>
            )}
          </div>
        </div>

        {hasImages && (
          <section class="portfolio-detail-media" aria-label={`${fullItem.title} media gallery`}>
            <div class="portfolio-carousel" data-carousel>
              <div class="portfolio-carousel-track" data-carousel-track>
                {imageItems.map((image, index) => (
                  <figure
                    class={`portfolio-carousel-slide${index === 0 ? ' is-active' : ''}`}
                    data-carousel-slide
                    aria-hidden={index === 0 ? 'false' : 'true'}
                  >
                    <ContentImage
                      src={image.url}
                      width={image.width}
                      height={image.height}
                      alt={image.description || image.title || `${fullItem.title} screenshot ${index + 1}`}
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                    {(image.title || image.description) && (
                      <figcaption>
                        {image.title && <strong>{image.title}</strong>}
                        {image.description && <span>{image.description}</span>}
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>

              {imageItems.length > 1 && (
                <div class="portfolio-carousel-controls">
                  <button type="button" class="portfolio-carousel-button" data-carousel-prev aria-label="Show previous image">
                    Previous
                  </button>
                  <div class="portfolio-carousel-dots" aria-label="Choose image">
                    {imageItems.map((image, index) => (
                      <button
                        type="button"
                        class={`portfolio-carousel-dot${index === 0 ? ' is-active' : ''}`}
                        data-carousel-dot
                        data-slide-index={index}
                        aria-label={`Show image ${index + 1}${image.title ? `: ${image.title}` : ''}`}
                        aria-pressed={index === 0 ? 'true' : 'false'}
                      />
                    ))}
                  </div>
                  <button type="button" class="portfolio-carousel-button" data-carousel-next aria-label="Show next image">
                    Next
                  </button>
                </div>
              )}
            </div>
          </section>
        )}
      </section>

      {fullItem.features && (
        <section class="portfolio-detail-side">
          <div class="portfolio-detail-panel portfolio-detail-richtext">
            <h2>Features</h2>
            <div class="portfolio-detail-richtext-content">
              <Fragment set:html={displayRichText(fullItem.features)} />
            </div>
          </div>
        </section>
      )}

      <aside class="portfolio-detail-full portfolio-detail-panel" aria-label="Work with Emma">
        <h2>Have something similar in mind?</h2>
        <p>I offer website and CMS development, full-stack applications, accessibility improvements and technical guidance.</p>
        <a href="/freelance/" class="freelance-text-link">Explore my freelance services</a>
      </aside>

      {fullItem.isIframe && fullItem.externalUrl && (
        <section class="portfolio-detail-full">
          <div class="portfolio-detail-panel">
            <h2>Live Demo</h2>
            <iframe 
              src={fullItem.externalUrl} 
              class="portfolio-detail-iframe"
              title={`${fullItem.title} live demo`}
              loading="lazy"
            ></iframe>
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  const carousels = document.querySelectorAll('[data-carousel]');

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll('[data-carousel-slide]'));
    const dots = Array.from(carousel.querySelectorAll('[data-carousel-dot]'));
    const previousButton = carousel.querySelector('[data-carousel-prev]');
    const nextButton = carousel.querySelector('[data-carousel-next]');

    if (slides.length <= 1) {
      return;
    }

    let activeIndex = 0;

    const renderSlides = () => {
      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });

      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-pressed', String(isActive));
      });
    };

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      renderSlides();
    };

    previousButton?.addEventListener('click', () => showSlide(activeIndex - 1));
    nextButton?.addEventListener('click', () => showSlide(activeIndex + 1));

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => showSlide(index));
    });
  });

</script>
