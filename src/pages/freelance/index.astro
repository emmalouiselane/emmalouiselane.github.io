---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculateYearsExperience } from '../../lib/experience';
import { person, siteMetadata } from '../../lib/seo';

const yearsExperience = calculateYearsExperience();

const services = [
  { number: '01', title: 'Consultancy, guidance and mentoring', text: 'Help with requirements, technical decisions and delivery workflows, plus code reviews, pair programming and one-to-one mentoring to build developer confidence.' },
  { number: '02', title: 'Application security reviews', text: 'Focused reviews of websites, applications and APIs, guided by OWASP principles, with prioritised findings, practical recommendations and support implementing fixes.' },
  { number: '03', title: 'Secure development and design', text: 'Help considering risks, reviewing solution designs and building safer practices into code reviews, developer mentoring and CI/CD workflows.' },
  { number: '04', title: 'Full-stack development', text: 'Web applications, APIs and internal tools built with React, TypeScript, Node.js, C# and .NET, connecting accessible interfaces with maintainable backend services.' },
  { number: '05', title: 'Websites and CMS builds', text: 'New websites, refreshes and CMS integrations with responsive layouts, clear navigation and content management that works for the people using it.' },
  { number: '06', title: 'Accessibility improvements', text: 'Focused reviews and practical fixes for page structure, keyboard interaction, forms and readable content, alongside accessible component development.' }
];

const structuredData = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Freelance development, security reviews, consultancy and mentoring',
  url: `${siteMetadata.url}/freelance/`,
  description: 'Freelance website and full-stack development, application security reviews, secure development guidance, accessibility improvements, consultancy and mentoring from Emma Lane, with an MSc in Computer Science and Cyber Security.',
  provider: { '@id': person['@id'] },
  serviceType: services.map(service => service.title),
};
---

<BaseLayout title="Freelance - Work with me" description="Accessible websites, full-stack development, application security reviews, secure development guidance and mentoring from Emma Lane, software engineer and technical lead." structuredData={structuredData}>
  <div class="freelance-page">
    <header class="freelance-hero">
      <div class="freelance-hero__copy">
        <p class="home-kicker">Work with me</p>
        <h1>Thoughtful websites.<br />Practical software.<br /><em>Built around people.</em></h1>
        <p class="freelance-summary">I build accessible websites and practical software, and offer application security reviews, consultancy and mentoring.</p>
        <div class="freelance-actions button-group">
          <a href="#contact" class="home-pill">Tell me how I can help</a>
          <a href="/about/" class="home-pill home-pill home-pill--secondary">About me</a>
        </div>
      </div>
      <aside class="freelance-note">
        <p class="home-card__eyebrow">A little about my approach</p>
        <h2>Good work starts with listening.</h2>
        <p>Clear communication, practical advice and thoughtful decisions, shaped around what you need.</p>
        <img src="/images/flowers/pressed-sprig.svg" alt="" width="150" height="150" />
      </aside>
    </header>

    <section class="freelance-section" aria-labelledby="services-heading">
      <p class="home-kicker">How I can help</p>
      <h2 id="services-heading">Development, security reviews and guidance</h2>
      <div class="freelance-services">
        {services.map(service => <article class="freelance-card">
          <div>
            <span class="freelance-number" aria-hidden="true">{service.number}</span>
            <h3>{service.title}</h3>
          </div>          
          <p>{service.text}</p>
        </article>)}
      </div>
    </section>

    <section class="freelance-section" aria-labelledby="work-heading">
      <p class="home-kicker">From my portfolio</p>
      <h2 id="work-heading">Explore my work</h2>
      <p>See examples of my development work, with implementation details, live demos and source code.</p>
      <a href="/portfolio/" class="freelance-text-link">View my portfolio <span aria-hidden="true">→</span></a>
    </section>

    <section class="freelance-section freelance-card" aria-labelledby="experience-heading">
      <p class="home-kicker">Engineering, leadership and security</p>
      <h2 id="experience-heading">Experience behind the work</h2>
      <p>I bring over {yearsExperience} years in development and technical leadership, including practical experience of security assessments, audits and resolving software vulnerabilities.</p>
      <p>I hold an <strong>MSc in Computer Science and Cyber Security with Distinction from the University of Sunderland</strong>.</p>
      <p><a class="freelance-text-link" href="/about/my-cv/">Read about my experience and technical skills <span aria-hidden="true">→</span></a></p>
    </section>

    <section class="freelance-section" aria-labelledby="process-heading">
      <p class="home-kicker">Working together</p>
      <h2 id="process-heading">From a conversation to a clear next step</h2>
      <ol class="freelance-process">
        <li><h3>Start with a conversation</h3><p>Tell me what you want to achieve; an outline is enough to get started.</p></li>
        <li><h3>Agree the scope</h3><p>We'll agree outcomes, timings and costs, including the systems and code in scope, required access and permitted activities for security reviews.</p></li>
        <li><h3>Build, guide and review</h3><p>I'll keep you involved throughout the work, with practical outcomes and clear next steps.</p></li>
      </ol>
    </section>

    <div class="freelance-enquiries">
      <section id="tech-for-good" class="freelance-section freelance-card" aria-labelledby="tech-for-good-heading" tabindex="-1">
        <p class="home-kicker">Making a positive difference</p>
        <h2 id="tech-for-good-heading">Tech for good and charity projects</h2>
        <p>I offer work free of charge or at heavily reduced rates for charities, community groups and projects with a positive social or environmental impact, depending on scope and availability.</p>
        <p>Tell me who your project helps, what you need and your budget, even if that's none.</p>
        <a href="mailto:emma@sparklane.dev?subject=Tech%20for%20good%20or%20charity%20enquiry" class="freelance-text-link">Email me about your tech for good project</a>
      </section>

      <section id="contact" class="freelance-contact" aria-labelledby="contact-heading">
        <p class="home-kicker">Have a project, question or learning goal?</p>
        <h2 id="contact-heading">Let's talk about what you need.</h2>
        <p>Tell me what you need, with a website link, budget and timescale if you have them. I'll get back to you to discuss scope and availability.</p>
        <a href="mailto:emma@sparklane.dev?subject=Development%2C%20security%20review%20or%20consultancy%20enquiry" class="home-pill">Email me at emma@sparklane.dev</a>
      </section>
    </div>
  </div>
</BaseLayout>
