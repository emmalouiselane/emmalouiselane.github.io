---
import StructuredData from './StructuredData.astro';
import { siteMetadata } from '../lib/seo';
interface Props { items: { name: string; path: string }[]; }
const { items } = Astro.props;
const data = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.name,
    item: new URL(item.path, siteMetadata.url).href,
  })),
};
---
<StructuredData data={data} />
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>{items.map((item, index) => <li>{index === items.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}</li>)}</ol>
</nav>
