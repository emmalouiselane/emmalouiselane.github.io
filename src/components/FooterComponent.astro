---
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faLinkedin, faGithub, faFacebook } from "@fortawesome/free-brands-svg-icons";
import GitCommitsModal from "./GitCommitsModal.astro";

const footerTagline =
  "Sparks fuel ideas — SparkLane.dev brings those ideas to life.";
const social = {
  linkedIn: "https://linkedin.com/in/emmalouiselane",
  gitHub: "https://github.com/emmalouiselane",
  facebook: "https://www.facebook.com/SparkLaneDev/",
};
---

<div class="footer-content">
  <div class="footer-content__inner">
    <div
      class="footer-content__accessibility"
    >
      <a class="navbar-link" href="/accessibility-statement/">Accessibility</a>
    </div>

    <div class="footer-content__center">
      <div class="footer-content-center">
        <p>{footerTagline}</p>
      </div>
    </div>

    <div class="footer-content__social">
      <div
        class="footer-content-right"
      >
        <GitCommitsModal />

        {
          social?.gitHub && (
            <a
              class="link social-link"
              href={social.gitHub}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
            >
              <FontAwesomeIcon
                icon={faGithub}
                size="2x"
                aria-label="GitHub"
                aria-hidden="true"
              />
            </a>
          )
        }
        {
          social?.linkedIn && (
            <a
              class="link social-link"
              href={social.linkedIn}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <FontAwesomeIcon
                icon={faLinkedin}
                size="2x"
                aria-label="LinkedIn"
                aria-hidden="true"
              />
            </a>
          )
        }
        {
          social?.facebook && (
            <a
              class="link social-link"
              href={social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <FontAwesomeIcon
                icon={faFacebook}
                size="2x"
                aria-label="Facebook"
                aria-hidden="true"
              />
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
