---
import '@fontsource-variable/montserrat';
import SEOComponent from '../components/SEOComponent.astro';
import NavbarComponent from '../components/NavbarComponent';
import FooterComponent from '../components/FooterComponent.astro';
import '../styles/global.css';
import '../styles/global.scss'; // Custom SCSS

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const pathname = Astro.url.pathname;
const isRootPath = pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <SEOComponent title={title} description={description} image={image} />
    
    <!-- Tinylytics -->
    <script src="https://tinylytics.app/embed/XpJY1f7mwvZcsmaUenvF.js?kudos=%E2%9D%A4%EF%B8%8F" defer></script>

    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="site-shell">
      <NavbarComponent client:load />
      
      <main id="main-content" class="site-main">
        <div class:list={['site-frame', isRootPath && 'is-root-path']} data-is-root-path={isRootPath}>
          <slot />
        </div>
      </main>
      
      <footer class="site-footer">
        <FooterComponent />
      </footer>
    </div>
  </body>
</html>




